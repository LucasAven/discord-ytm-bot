# Token del bot: Developer Portal -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# ID de tu server (Modo Desarrollador -> click derecho en el server -> Copiar ID).
# Con esto los slash commands aparecen al instante. Vacío = sync global (tarda hasta 1h).
# Podés poner varios separados por coma.
GUILD_IDS=

# Opcional: dónde está la sesión de YouTube Music.
# YTM_AUTH_FILE=browser.json
