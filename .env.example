# Token del bot: Developer Portal -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# ID de tu server (Modo Desarrollador -> click derecho en el server -> Copiar ID).
# Con esto los slash commands aparecen al instante. Vacío = sync global (tarda hasta 1h).
# Podés poner varios separados por coma.
GUILD_IDS=

# Opcional: tu sesión de YouTube Music, para que el bot vea tus playlists.
# Sin esto anda igual para buscar temas, links y autoplay.
#
# Se saca del navegador: music.youtube.com con tu cuenta iniciada, F12, solapa
# Network, clic en cualquier tema, filtro "youtubei", clic en el primer renglón,
# solapa Headers, botón "Raw" al lado de Request Headers, y copiar el renglón
# que empieza con "cookie:".
#
# Va en UN SOLO renglón y entre comillas. Al arrancar, el bot arma browser.json
# solo, y lo rehace cuando esta cookie cambia. Vence cada tanto: cuando el bot
# deje de ver tus playlists, pegá la nueva acá.
#
# Es tu sesión de Google: quien la tenga entra a tu cuenta sin contraseña.
# YTM_COOKIE=""

# Opcional: dónde guardar la sesión de YouTube Music.
# YTM_AUTH_FILE=browser.json
